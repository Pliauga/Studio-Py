{
	"name": "studio-py",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:pedagogy": "python3 src/content/lessons/lint_curriculum_pedagogy.py",
		"lint:solutions": "python3 src/content/lessons/lint_solutions.py",
		"check:grading": "node --experimental-strip-types scripts/check-grading.mjs",
		"check:regrade": "node --experimental-strip-types scripts/check-regrade.mjs",
		"audit:prose": "node --experimental-strip-types scripts/check-prose-answers.mjs",
		"check:timeouts": "node --experimental-strip-types scripts/check-timeouts.mjs",
		"check:live": "node --experimental-strip-types scripts/check-live.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/three": "^0.186.0",
		"lil-gui": "^0.21.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"pyodide": "^314.0.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.152.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@dimforge/rapier3d-compat": "0.21.0",
		"@lezer/highlight": "^1.2.5",
		"@threlte/core": "8.6.1",
		"@threlte/extras": "9.22.3",
		"@threlte/rapier": "3.5.1",
		"@threlte/theatre": "3.2.2",
		"codemirror": "^6.0.2",
		"three": "^0.186.1"
	}
}
